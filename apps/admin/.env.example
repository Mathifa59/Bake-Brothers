# apps/api — el puente para "Nuevo pedido" (POST /api/dashboard/orders).
# Mismo nombre de variable que ya usa apps/web.
VITE_API_URL=https://api.bake-brothers.com

# Funciones apagadas por defecto (ver src/config/funciones.js). Hay que volver a construir el panel (Redeploy en Vercel)
# para que tomen efecto.
# VITE_MIFACT_ACTIVO=true muestra el botón «Comprobante» (emitir boleta/factura) en cada pedido facturable, solo para
# administración. NO activarla hasta tener el token de producción de Mifact.
VITE_MIFACT_ACTIVO=false
# VITE_MIFACT_IMPORTADOR=true muestra la pestaña «Códigos de Mifact» dentro de Catálogo (importar códigos de producto
# desde el Excel de Mifact). Déjala apagada: la tabla de códigos aún se identifica por almacén y no por empresa.
VITE_MIFACT_IMPORTADOR=false

# Dominio del correo interno de las cuentas con usuario (se completa solo cuando alguien escribe su usuario sin «@»).
# Tiene que ser el mismo que DOMINIO_EQUIPO de la API. Por defecto equipo.bakebrothers.pe.
# VITE_DOMINIO_EQUIPO=equipo.bakebrothers.pe
