# URL de la API (apps/api). Si esta variable NO está definida (ni aquí ni en
# Vercel), la tienda corre en modo demo: catálogo y pedidos 100% locales, sin
# red ni base de datos (ver src/api/demoFallback.js). Descomenta la línea de
# abajo — y levanta `pnpm dev:api` con Postgres configurado — para conectarla
# a la API real sin tocar ninguna página.
# VITE_API_URL=http://localhost:3001

# Tenant que sirve esta tienda
VITE_TENANT_SLUG=bake-brothers
