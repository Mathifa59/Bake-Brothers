# Conexión Postgres (rol app_api — sujeto a RLS, nunca el rol postgres)
DATABASE_URL=postgres://app_api.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

PORT=3001

# Tenant por defecto cuando el request no manda X-Tenant-Slug (dev)
DEFAULT_TENANT_SLUG=bake-brothers

# Token de verificación del webhook de Meta (GET /webhook, hub.verify_token).
# Lo generamos nosotros, no Meta — se pega tal cual en el dashboard de la app
# de Meta cuando se configure el webhook con credenciales reales (Semana 2).
META_VERIFY_TOKEN=cambiame

# App Secret real de Meta — habilita la verificación de X-Hub-Signature-256
# en POST /webhook (bot/meta.ts). Sin esta variable, el comportamiento es
# idéntico al de antes (acepta sin firma).
# META_APP_SECRET=

# Token permanente de la Cloud API de WhatsApp — habilita el envío real de
# la respuesta del bot (bot/meta.ts, enviarMensajeMeta). Sin esta variable,
# el bot procesa el mensaje pero no puede entregarlo — la conversación queda
# escalada automáticamente (ver bot/procesarWebhookWhatsApp.ts) en vez de
# fallar en silencio.
# META_WHATSAPP_TOKEN=
