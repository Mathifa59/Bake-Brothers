# Conexión Postgres (rol app_api — sujeto a RLS, nunca el rol postgres)
DATABASE_URL=postgres://app_api.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

PORT=3001

# Tenant por defecto cuando el request no manda X-Tenant-Slug (dev)
DEFAULT_TENANT_SLUG=bake-brothers

# Token de verificación del webhook de Meta (GET /webhook, hub.verify_token).
# Lo generamos nosotros, no Meta — se pega tal cual en el dashboard de la app
# de Meta cuando se configure el webhook con credenciales reales (Semana 2).
META_VERIFY_TOKEN=cambiame

# App Secret real de Meta — habilita la verificación de X-Hub-Signature-256
# en POST /webhook (bot/meta.ts). Fuera de producción, sin ella se acepta sin firma (desarrollo y tests);
# en PRODUCCIÓN, sin ella POST /webhook responde 503 (nada entra todavía) — la API arranca igual.
# META_APP_SECRET=

# Clave AES-256 que cifra en la base los tokens de negocio de WhatsApp
# (whatsapp_conexiones.token_cifrado). Sin ella la API ARRANCA igual (WhatsApp
# sin conectar) y lo avisa en el log; solo falla, visible, al intentar conectar un número. Una clave mal
# formada sí impide arrancar. 32 bytes en
# hex (64 caracteres) o base64. Generar una:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GUÁRDALA fuera del repo y respáldala: si se pierde, hay que reconectar cada
# número (los tokens guardados ya no se podrían descifrar).
# WHATSAPP_TOKEN_ENCRYPTION_KEY=

# Ya NO existe META_WHATSAPP_TOKEN (un token único por variable de entorno):
# el token para enviar vive cifrado en la base, uno por número conectado
# (whatsapp_conexiones). PLAN VIGENTE: un número NUEVO solo para el bot,
# conectado directo a la API de Meta en una app del portafolio de Bake
# Brothers, con token de USUARIO DEL SISTEMA (no vence). Se registra a mano:
#   WHATSAPP_TOKEN_A_REGISTRAR=<token> pnpm whatsapp:registrar -- #     --bot --waba <waba_id> --phone <phone_number_id> --tipo sistema
# Los números de los locales no se tocan. Detalle en scripts/registrar-conexion-whatsapp.ts.
#
# En PRODUCCIÓN, POST /webhook responde 503 mientras no exista META_APP_SECRET
# (la firma de Meta es obligatoria): configúralo ANTES de apuntar el webhook.

# Delivery: AMBAS sedes despachan, así que un delivery del bot nace sin sede,
# lo ven todas las sedes en Pedidos y la que lo toma ("Me lo quedo") se lo
# queda. Ya no existe la variable SEDE_DELIVERY. Los pedidos para recoger
# siempre llevan el local que el cliente elige.

# Embedded Signup de Meta: NO se terminó de construir y el plan vigente no lo
# usa. Reservado y apagado; hoy ninguna ruta lo lee.
# WHATSAPP_EMBEDDED_SIGNUP=false

# Versión de la Graph API para las llamadas a Meta.
# META_GRAPH_VERSION=v21.0

# Coexistence: horas sin mensajes humanos tras las que el bot retoma una
# conversación que el equipo atendió desde el celular (message echo).
# AUTO_RETORNO_BOT_HORAS=3

# --- Reglas de lanzamiento (2026-10-29) ---
# Distritos con delivery de tienda, separados por coma (el valor por defecto es el de la ficha real). El bot
# no toma un delivery a un distrito que no esté acá; vacío = sin restricción. El costo del envío lo cotiza
# y coordina una persona.
# DISTRITOS_DELIVERY=Chorrillos, Surco, Miraflores, San Isidro, Villa el Salvador, San Juan de Miraflores, La Victoria, Jesús María, Lince
#
# WhatsApp de atención directa de mayoristas (solo dígitos, con código de país). El bot no les cotiza ni les toma
# pedidos: los deriva a este número con un link wa.me. Por defecto el real; solo se pone si cambia.
# WHATSAPP_MAYORISTAS=51986639228
#
# Datos para pagar por adelantado. Texto libre en UNA línea: la secuencia «barra n» (\n) se convierte en salto de
# línea al mostrarla. Dos razones sociales, cada una con los suyos — nunca se usan los de una para el local de la otra:
#   DATOS_PAGO        = Baker Brothers E.I.R.L. (Yape, BCP, Interbank) → recojo en Santa Marina; todo delivery lo cobra una persona con estos.
#   DATOS_PAGO_CEDROS = Corporación Hermanos Loarte S.A.C.            → recojo en Cedros.
# Si el que corresponde está, el bot se los da al cliente apenas registra el pedido; si NO está, el bot avisa que una
# persona se los envía y la conversación pasa al equipo. Se cargan en Coolify, no en git.
# DATOS_PAGO=Baker Brothers E.I.R.L.\nYape: 999 999 999\nBCP: ...\nInterbank: ...
# DATOS_PAGO_CEDROS=Corporación Hermanos Loarte S.A.C.\nYape: ...\nBCP: ...

# --- Notificaciones push del panel (Web Push) ---
# Par de claves VAPID: se generan UNA vez con `pnpm --filter @bakebrothers/api vapid:generar` y se cargan en
# Coolify (la privada es secreta). Sin ellas el panel sigue funcionando y el centro de avisos (campana) también;
# solo no llegan notificaciones al celular.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://dashboard.bakebrothers.pe

# --- Modelo de Claude del bot ---
# Vacío = Sonnet (el probado hoy). Para pasar a Haiku (más barato y rápido) cambiar la variable en Coolify y
# reiniciar; ANTES volver a correr los casos del bot (docs/cambio-a-haiku.md). La lectura de capturas de pago
# tiene su propia variable y se queda en Sonnet aunque la conversación pase a Haiku.
# BOT_MODELO=claude-haiku-5-5
# BOT_MODELO_CAPTURAS=

# --- Respuestas automáticas de Instagram (docs/respuestas-automaticas-instagram.md) ---
# La cuenta se conecta una vez con `pnpm instagram:registrar` (el token queda cifrado en instagram_conexion, con
# WHATSAPP_TOKEN_ENCRYPTION_KEY). Las dos variables siguientes son opcionales: ya traen el valor correcto.
# Dominio del link corto del DM (https://www.bakebrothers.pe/w/ig-alfajor): la web lo reenvía a esta API con un rewrite
# de Vercel (vercel.json de la raíz).
# URL_ENLACES_CORTOS=https://www.bakebrothers.pe
# WhatsApp que atiende a los clientes (a donde lleva el link corto). Por defecto el de atención.
# WHATSAPP_ATENCION=51912944096
