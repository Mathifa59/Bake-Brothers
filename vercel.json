{
  "buildCommand": "pnpm --filter @bakebrothers/domain build && pnpm --filter @bakebrothers/web build",
  "installCommand": "pnpm install",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/menu", "destination": "/menu/index.html" },
    { "source": "/locales", "destination": "/locales/index.html" },
    { "source": "/privacidad", "destination": "/privacidad/index.html" }
  ]
}
