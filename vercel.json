{
  "buildCommand": "pnpm --filter @bakebrothers/domain build && pnpm --filter @bakebrothers/web build",
  "installCommand": "pnpm install",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/w/:referencia", "destination": "https://api.bake-brothers.com/w/:referencia" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
